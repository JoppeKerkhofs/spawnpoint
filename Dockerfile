# syntax=docker/dockerfile:1
# One image for the whole panel: Nginx, PHP-FPM, a queue worker, the scheduler and the Rust service.

FROM rust:1-slim-bookworm AS service
WORKDIR /src
COPY service/Cargo.toml service/Cargo.lock ./
COPY service/src src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked && cp target/release/mcpanel-service /mcpanel-service

FROM php:8.5-fpm-bookworm AS php
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions pdo_mysql pcntl
WORKDIR /app

# Building the frontend needs PHP too: the route helpers it imports are generated by artisan.
FROM php AS build
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*
COPY panel/composer.json panel/composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY panel/package.json panel/package-lock.json panel/.npmrc ./
RUN npm ci
COPY panel .
RUN composer dump-autoload --optimize --no-dev \
    && php artisan wayfinder:generate --with-form \
    && npm run build \
    && rm -rf node_modules

FROM php AS app
# unzip is used by the Rust service for world imports; tar and gzip for backups are already there.
RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor unzip \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY --from=service /mcpanel-service /usr/local/bin/mcpanel-service
COPY --from=build /app /app
# The web user may write only where Laravel keeps its caches, not the code.
# The chmod matters when the image is built from a checkout that marks every file writable, as Windows does.
RUN chmod -R go-w . && chown -R www-data:www-data storage bootstrap/cache
COPY docker/nginx.conf /etc/nginx/conf.d/panel.conf
COPY docker/supervisord.conf /etc/supervisor/conf.d/panel.conf
COPY --chmod=755 docker/entrypoint.sh /usr/local/bin/entrypoint

# The Rust service is reached through Nginx at /node, never directly from outside the container.
ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    MCPANEL_LISTEN=127.0.0.1:8080 \
    PANEL_NODE_URL=http://127.0.0.1:8080 \
    PANEL_NODE_PUBLIC_URL=/node

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD curl -fsS http://127.0.0.1/up || exit 1
ENTRYPOINT ["entrypoint"]
