# Settings for compose.node.yaml, on a host that only runs a node. Copy to .env.node and fill in.

# The token the panel showed when this node was added under Nodes.
SPAWNPOINT_TOKEN=

# Only when the panel runs another version than compose.node.yaml names: a node has to be on
# the panel's version, so both speak the same language.
# PANEL_VERSION=

# This host's address on the private network or VPN it shares with the panel, and the port the
# panel reaches the node on. The panel's "Address of the node" is http://<NODE_BIND>:<NODE_PORT>.
# Do not use 0.0.0.0 on a host that is reachable from the internet.
NODE_BIND=
NODE_PORT=8080

# Ports on this machine: where players join, and the web maps.
MINECRAFT_PORT=25565
BLUEMAP_PORT=8100
# The address the web maps port is bound to; 127.0.0.1 when a proxy on this host serves them.
# BLUEMAP_BIND=0.0.0.0

# Folders on this host; these defaults are created if missing.
# SPAWNPOINT_DATA_DIR=/srv/mc
# SPAWNPOINT_BACKUP_DIR=/srv/mc-backups
# SPAWNPOINT_IMPORT_DIR=/srv/mc-import

# TLS, so the panel's traffic to this node is encrypted as well as signed. Put the certificate
# and key in ./tls, uncomment that volume in compose.node.yaml, and give the node an https
# address in the panel. The panel has to trust whoever signed it; see README.md.
# SPAWNPOINT_TLS_CERT=/tls/node.crt
# SPAWNPOINT_TLS_KEY=/tls/node.key
