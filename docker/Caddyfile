{
	admin off
	frankenphp
}

:8080 {
	root * /app/public
	encode zstd br gzip

	# No other site may show the panel in a frame, where a click could be steered to a button here.
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}

	# The browser talks to a node only for what a token authorises: the live console, uploads
	# and downloads. The address is /node/<number of the node>/..., and the panel says where
	# that node is. A node's signed API is never reachable through here.
	@node path_regexp node ^/node/([0-9]+)(/servers/[^/]+/(console|upload|download|backups/[^/]+/download))$
	handle @node {
		# In this order, whatever Caddy would otherwise make of it.
		route {
			# Whatever the browser sent under this name is dropped; only the panel's answer counts.
			request_header -X-Node-Upstream
			forward_auth 127.0.0.1:8080 {
				uri /node-upstream/{re.node.1}
				copy_headers X-Node-Upstream
			}
			uri strip_prefix /node/{re.node.1}
			reverse_proxy {http.request.header.X-Node-Upstream} {
				# Console output and file transfers are passed on as they come, whatever their size.
				flush_interval -1
			}
		}
	}

	# The pages' WebSocket for live updates, served by the realtime container. Without that
	# container this fails and the pages fall back to asking every few seconds. Anything else
	# under this address is the panel's to answer, with its own "not found".
	@realtime {
		path /app/*
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @realtime {
		reverse_proxy {$REVERB_UPSTREAM:realtime:8081}
	}

	handle {
		php_server
	}
}
