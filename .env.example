# Copy to .env and fill in. This file configures "docker compose".

# prod: the whole panel from one image. dev: only the Rust service, for a panel run from panel/.
COMPOSE_PROFILES=prod

# A long random secret shared by the panel and the Rust service (32+ characters).
MCPANEL_TOKEN=

# --- prod only ---

# The release to run, such as 1.0.0. "latest" follows every merge to main.
PANEL_VERSION=latest

# Generate with: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
# The address you open the panel on. Use https:// when a proxy such as Cloudflare adds TLS.
APP_URL=http://localhost
PANEL_PORT=80
DB_PASSWORD=

# The first admin, created on the first start only. Change the password after logging in.
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_PASSWORD=

# Every server gets a hostname under this domain; point a wildcard DNS record at the host.
PANEL_BASE_DOMAIN=mc.localhost
# Where port 8100 of this host is reachable from outside, for the BlueMap links.
PANEL_BLUEMAP_URL=http://localhost:8100
# Optional: needed to search CurseForge and install its packs.
CURSEFORGE_API_KEY=

# --- folders on the host (these defaults are created if missing) ---
# MCPANEL_DATA_DIR=/srv/mc
# MCPANEL_BACKUP_DIR=/srv/mc-backups
# MCPANEL_IMPORT_DIR=/srv/mc-import
